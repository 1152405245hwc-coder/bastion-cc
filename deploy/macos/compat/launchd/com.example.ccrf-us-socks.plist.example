<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.ccrf-us-socks</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-NT</string>
    <string>-o</string>
    <string>BindInterface=en0</string>
    <string>-o</string>
    <string>BatchMode=yes</string>
    <string>-o</string>
    <string>StrictHostKeyChecking=yes</string>
    <string>-o</string>
    <string>ServerAliveInterval=15</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-i</string>
    <string>REPLACE_WITH_PRIVATE_KEY_PATH</string>
    <string>-p</string>
    <string>SSH_PORT</string>
    <string>-D</string>
    <string>127.0.0.1:SOCKS_PORT</string>
    <string>DEPLOY_USER@HOST</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_PRIVATE_LOG_PATH</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_PRIVATE_ERROR_LOG_PATH</string>
</dict>
</plist>
